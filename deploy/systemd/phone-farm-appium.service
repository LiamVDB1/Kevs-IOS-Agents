[Unit]
Description=Phone Farm Appium 3
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
Environment=HOME=__HOME__
Environment=PATH=__NODE_BIN__:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-__REPO__/.env
ExecStart=__NODE_BIN__/npm run appium
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
