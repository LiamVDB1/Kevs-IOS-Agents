[Unit]
Description=Phone Farm WebDriverAgent supervisor
After=network.target phone-farm-tunnel.service phone-farm-appium.service
Wants=phone-farm-tunnel.service phone-farm-appium.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
Environment=HOME=__HOME__
Environment=PATH=__NODE_BIN__:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-__REPO__/.env
Environment=WDA_BACKEND=remotexpc
ExecStart=__NODE_BIN__/npm run wda:service
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
